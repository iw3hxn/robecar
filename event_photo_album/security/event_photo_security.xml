<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Regole di accesso per il record -->
        <record id="event_photo_rule_public" model="ir.rule">
            <field name="name">Public Photos</field>
            <field name="model_id" ref="model_event_photo"/>
            <field name="domain_force">[('public', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_public'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regola per utenti portal -->
        <record id="event_photo_rule_portal" model="ir.rule">
            <field name="name">Portal: see and upload photos</field>
            <field name="model_id" ref="model_event_photo"/>
            <field name="domain_force">[('public', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regola per utenti interni -->
        <record id="event_photo_rule_internal" model="ir.rule">
            <field name="name">Internal: full access to photos</field>
            <field name="model_id" ref="model_event_photo"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>