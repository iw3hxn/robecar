<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_event_form_inherit_ticket" model="ir.ui.view">
        <field name="name">event.form.inherit</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='question_ids']/list" position="inside">
                <field
                        name="print_question"
                        invisible="question_type not in ['simple_choice', 'text_box']"
                        widget="boolean_icon"
                        options="{'icon': 'fa-eye-slash'}"
                />
            </xpath>
        </field>
    </record>

</odoo>
