<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="event.attendee_list" model="ir.ui.view">
        <field name="name">attendee_list</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t t-name="event.attendee_list">
                <t t-set="global_count" t-value="1"/>
                <h1>Attendee list</h1>
                <div class="row">
                    <div class="col-7">
                        <div t-out="event.name"/>
                    </div>
                    <div class="col-5">
                        <span t-out="event.date_begin_located"/>
                        <i class="fa fa-arrow-right"/>
                        <span t-out="event.date_end_located"/>
                    </div>
                </div>
                <tr t-foreach="attendees.grouped('position_id').items()" t-as="position">
                    <t t-set="table_name" t-value="position[0]"/>
                    <t t-set="registrations" t-value="position[1]"/>

                    <h1>
                        <div t-out="table_name.display_name or ''"/>
                    </h1>
                    <t t-if="table_name.description">

                        <t t-out="table_name.description"/>


                    </t>


                    <table class="table table-bordered border-dark" style="page-break-after:always;">
                        <thead>
                            <tr class="text-start fs-5 fw-bold">
<!--                                <th class="border border-dark">#</th>-->
                                <th class="border border-dark">Nome</th>
                                <t t-foreach="event.question_ids.filtered_domain([('print_question', '=', True)])"
                                   t-as="question">
                                    <th class="border border-dark" t-out="question.title"/>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="table_count" t-value="1"/>
                            <tr t-foreach="registrations" t-as="registration">
<!--                                <td class="border border-dark">-->
<!--                                    <t t-esc="global_count"/>/<t t-esc="table_count"/>-->
<!--                                </td>-->
                                <td class="border border-dark"><t t-out="registration.tableau_mariage_name"/></td>
                                <t t-foreach="event.question_ids.filtered_domain([('print_question', '=', True)])"
                                   t-as="question">
                                    <td class="border border-dark">
                                        <t t-set="answer"
                                           t-value="registration.registration_answer_ids.filtered(lambda a: a.question_id == question)"/>
                                        <t t-if="answer">
                                            <t t-out="answer.display_name"/>
                                        </t>
                                    </td>
                                </t>
                                <t t-set="table_count" t-value="table_count + 1"/>
                                <t t-set="global_count" t-value="global_count + 1"/>
                            </tr>
                        </tbody>
                    </table>
                </tr>
            </t>
        </field>
    </record>
</odoo>